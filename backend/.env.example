# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# Database (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=credentials_vault
DB_USER=vault_user
DB_PASSWORD=your_db_password_here

# ============================================
# SECURITY: Master Encryption Key
# ============================================
# ⚠️ CRITICAL: Generate with: node scripts/generate-master-key.js
# ⚠️ NEVER commit the real key to git!
# ⚠️ In production, use AWS KMS / HashiCorp Vault / HSM
MASTER_ENCRYPTION_KEY=your_64_char_hex_key_here

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ============================================
# Frontend URL (for CORS)
# ============================================
CLIENT_URL=http://localhost:3000

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Password Policy
# ============================================
MIN_PASSWORD_LENGTH=12
REQUIRE_SPECIAL_CHAR=true